   </wvobject>
   <wvobject fp_name="/hsubtb/B" type="logic">
      <obj_property name="ElementShortName">B</obj_property>
      <obj_property name="ObjectShortName">B</obj_property>
   </wvobject>
   <wvobject fp_name="/hsubtb/Difference" type="logic">
      <obj_property name="ElementShortName">Difference</obj_property>
      <obj_property name="ObjectShortName">Difference</obj_property>
   </wvobject>
   <wvobject fp_name="/hsubtb/Borrow" type="logic">
